#!/bin/sh
# Same gate as CI: a branch without a prefix saying what it does (feat/, fix/, …), or that fails
# `npm run verify`, is not pushed. A push that only deletes branches carries no code, so it skips verify.
export PATH="$HOME/.local/node/current/bin:$PATH"
refs=$(cat)
printf '%s\n' "$refs" | node scripts/branch-name.mjs --pre-push || exit 1
printf '%s\n' "$refs" | awk '$2 != "" && $2 !~ /^0+$/ { code = 1 } END { exit !code }' || exit 0
exec npm run verify
