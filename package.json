{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prepare": "git config core.hooksPath .githooks",
    "start": "ng serve -c development-it --port 4201 & ng serve --port 4200",
    "build": "ng build && node --import ./scripts/ts-resolve.mjs scripts/postbuild.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:it": "ng serve -c development-it --port 4201",
    "i18n:extract": "ng extract-i18n --output-path src/locale",
    "og:images": "node --import ./scripts/ts-resolve.mjs scripts/og-images.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "lint": "ng lint --max-warnings=0",
    "verify": "npm run lint && ng test --no-watch && npm run test:scripts && npm run build && npm run e2e"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "gsap": "^3.15.0",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/localize": "^22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.12.0",
    "@types/three": "^0.186.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
