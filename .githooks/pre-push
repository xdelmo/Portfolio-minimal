#!/bin/sh
# The quick half of CI's gate: a branch without a prefix saying what it does (feat/, fix/, …), or that fails
# `npm run verify:quick` (lint, unit tests, script tests: a couple of minutes), is not pushed. Build and e2e run on the
# pull request's CI, which a PR passes before it is merged: the full verify here doubled 20 minutes per push, and two
# sessions running it at once on the same machine skewed each other's results (the user's choice, 2026-10-18).
# A push that only deletes branches carries no code, so it skips the checks.
export PATH="$HOME/.local/node/current/bin:$PATH"
refs=$(cat)
printf '%s\n' "$refs" | node scripts/branch-name.mjs --pre-push || exit 1
printf '%s\n' "$refs" | awk '$2 != "" && $2 !~ /^0+$/ { code = 1 } END { exit !code }' || exit 0
npm run verify:quick
